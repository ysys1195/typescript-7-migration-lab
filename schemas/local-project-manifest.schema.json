{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ysys1195/typescript-7-migration-lab/schemas/local-project-manifest.schema.json",
  "title": "TypeScript 7 Migration Lab local project manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "source",
    "commands",
    "syntheticComparisons"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "local-project-manifest" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "commands": {
      "type": "object",
      "required": ["install", "typecheck", "build"],
      "properties": {
        "install": { "$ref": "#/$defs/installCommand" },
        "typecheck": { "$ref": "#/$defs/compilerCommand" },
        "build": { "$ref": "#/$defs/compilerCommand" }
      },
      "additionalProperties": false
    },
    "syntheticComparisons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/syntheticComparison" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["url", "license", "commit"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "license": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "argumentList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "installCommand": {
      "type": "object",
      "required": ["executable", "args", "execution"],
      "properties": {
        "executable": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "args": { "$ref": "#/$defs/argumentList" },
        "execution": { "const": "manual-only" }
      },
      "additionalProperties": false
    },
    "compilerCommand": {
      "type": "object",
      "required": ["args"],
      "properties": {
        "args": { "$ref": "#/$defs/argumentList" }
      },
      "additionalProperties": false
    },
    "syntheticComparison": {
      "type": "object",
      "required": ["workload", "fixture", "rationale"],
      "properties": {
        "workload": { "enum": ["typecheck", "build"] },
        "fixture": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
